board = [' '] * 9

def show():
    for i in range(0, 9, 3):
        print(board[i:i+3])

def winner():
    lines = [
        (0,1,2), (3,4,5), (6,7,8),
        (0,3,6), (1,4,7), (2,5,8),
        (0,4,8), (2,4,6)
    ]

    for a, b, c in lines:
        if board[a] == board[b] == board[c] != ' ':
            return board[a]

    if ' ' not in board:
        return 'Draw'

    return None

def minimax(is_ai):
    result = winner()

    if result == 'O':
        return 1
    if result == 'X':
        return -1
    if result == 'Draw':
        return 0

    scores = []

    for i in range(9):
        if board[i] == ' ':
            board[i] = 'O' if is_ai else 'X'
            scores.append(minimax(not is_ai))
            board[i] = ' '

    return max(scores) if is_ai else min(scores)

def ai_move():
    best = -2
    move = -1

    for i in range(9):
        if board[i] == ' ':
            board[i] = 'O'
            score = minimax(False)
            board[i] = ' '

            if score > best:
                best = score
                move = i

    board[move] = 'O'

while winner() is None:
    show()

    try:
        pos = int(input("Enter position (1-9): ")) - 1
    except ValueError:
        print("Enter a number!")
        continue

    if pos not in range(9) or board[pos] != ' ':
        print("Invalid move!")
        continue

    board[pos] = 'X'

    if winner() is None:
        ai_move()

show()
print("Result:", winner())
