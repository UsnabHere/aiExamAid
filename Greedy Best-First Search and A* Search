import heapq

graph = {
    'A': [('B', 1), ('C', 4)],
    'B': [('D', 2), ('E', 5)],
    'C': [('D', 1)],
    'D': [('G', 3)],
    'E': [('G', 1)],
    'G': []
}

h = {'A': 5, 'B': 4, 'C': 3,
     'D': 2, 'E': 1, 'G': 0}

def search(start, goal, astar=False):
    pq = [(h[start], 0, start, [start])]
    best = {start: 0}

    while pq:
        f, cost, node, path = heapq.heappop(pq)

        if astar and cost > best[node]:
            continue

        if node == goal:
            return path, cost

        for neighbor, weight in graph[node]:
            new_cost = cost + weight

            if not astar or new_cost < best.get(neighbor, float('inf')):
                best[neighbor] = new_cost
                priority = new_cost + h[neighbor] if astar else h[neighbor]
                heapq.heappush(pq, (priority, new_cost,
                                    neighbor, path + [neighbor]))

    return None

print("Greedy:", search('A', 'G'))
print("A*:", search('A', 'G', True))
